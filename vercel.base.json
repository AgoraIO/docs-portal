    {
      "source": "/en/realtime-media/rtmp-gateway/build/set-up-and-authenticate/enable-media-gateway",
      "destination": "/en/realtime-media/rtmp-gateway/build/enable-media-gateway",
      "statusCode": 301
    }
  ],
  "routes": [
    {
      "src": "^/\\.well-known/mcp$",
      "dest": "/.well-known/mcp.json"
    },
    {
      "src": "^/(?:en/?)?$",
      "dest": "/en.md",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": ".*text/markdown.*"
        }
      ]
    },
    {
      "src": "^/en/((?!.*\\.md/?$).+?)/?$",
      "dest": "/en/$1.md",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": ".*text/markdown.*"
        }
      ]
    }
  ]
}
