{
  "buildCommand": "bun run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "redirects": [
    {
      "source": "/cn",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/conversational-ai/models/asr/overview",
      "destination": "/en/ai/models/asr/deepgram",
      "statusCode": 301
    },
    {
      "source": "/conversational-ai/models/llm/overview",
      "destination": "/en/ai/models/llm/openai",
      "statusCode": 301
    },
    {
      "source": "/conversational-ai/models/mllm/overview",
      "destination": "/en/ai/models/mllm/openai",
      "statusCode": 301
    },
    {
      "source": "/conversational-ai/models/tts/overview",
      "destination": "/en/ai/models/tts/openai",
      "statusCode": 301
    },
    {
      "source": "/en/realtime-media/video/reference/console-overview",
      "destination": "/en/introduction/console-setup",
      "statusCode": 301
    },
    {
      "source": "/en/realtime-media/voice/reference/console-overview",
      "destination": "/en/introduction/console-setup",
      "statusCode": 301
    },
    {
      "source": "/en/realtime-media/broadcast-streaming/reference/console-overview",
      "destination": "/en/introduction/console-setup",
      "statusCode": 301
    },
    {
      "source": "/en/realtime-media/interactive-live-streaming/reference/console-overview",
      "destination": "/en/introduction/console-setup",
      "statusCode": 301
    },
    {
      "source": "/en/realtime-media/rtm/console-overview",
      "destination": "/en/introduction/console-setup",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_build/|assets/|__static/|images/|openapi/|favicon.ico|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
