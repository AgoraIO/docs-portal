{
  "name": "docs-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:full": "vite dev",
    "dev:scope": "bun run dev",
    "build": "bun run legacy-redirects:check && bun run build:static",
    "build:static": "bun run openapi:sync && bun run docs:static-payload && bun run build:app:static && bun run build:route-html",
    "build:app:static": "TSS_SPA_STATIC_EXPERIMENT=true VITE_TSS_SPA_STATIC_EXPERIMENT=true vite build",
    "build:route-html": "node --experimental-strip-types scripts/generate-static-route-html.mjs",
    "docs:static-payload": "TSS_SPA_STATIC_EXPERIMENT=true VITE_TSS_SPA_STATIC_EXPERIMENT=true node scripts/generate-static-docs-payload.mjs",
    "start": "vite preview",
    "preview": "vite preview",
    "test": "vitest run",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "openapi:sync": "node scripts/sync-openapi-assets.mjs",
    "search:sync": "bun scripts/sync-algolia-search.mjs",
    "docs:links": "node scripts/audit-doc-links.mjs",
    "docs:links:strict": "node scripts/audit-doc-links.mjs --fail-on-invalid",
    "docs:links:classify": "node scripts/classify-doc-link-audit.mjs --out=docs/agents/reports/2026-06-30-doc-link-strict-classification.md",
    "docs:links:classify:check": "node scripts/classify-doc-link-audit.mjs --check --out=docs/agents/reports/2026-06-30-doc-link-strict-classification.md",
    "docs:links:external": "node scripts/audit-doc-links.mjs --check-external --external-concurrency=8 --external-retries=2 --external-timeout=5000",
    "legacy-redirects:generate": "node scripts/generate-legacy-redirect-artifacts.mjs",
    "legacy-redirects:check": "node scripts/generate-legacy-redirect-artifacts.mjs --check",
    "docs:lint:english": "node scripts/audit-english-doc-low-errors.mjs",
    "docs:migration-parity": "node scripts/audit-migration-parity.mjs",
    "docs:rendering-audit": "node scripts/audit-doc-rendering-patterns.mjs --out=docs/agents/reports/2026-06-25-legacy-rendering-pattern-audit",
    "lint": "biome check biome.json package.json source.config.ts tsconfig.json vite.config.ts src",
    "format": "biome format --write"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@orama/orama": "^3.1.18",
    "@tanstack/react-router": "1.168.22",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-start": "1.167.41",
    "@tanstack/start-static-server-functions": "1.166.33",
    "algoliasearch": "^5.55.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.9.0",
    "fumadocs-mdx": "15.0.7",
    "fumadocs-openapi": "^10.10.0",
    "fumadocs-ui": "16.9.0",
    "i18next": "^26.0.7",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "remark-directive": "^4.0.0",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "4.0.9",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.9.0",
    "nitro": "^3.0.260311-beta",
    "srvx": "^0.11.15",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@8.6.4+sha512.4968d718da1be7dbba5efaab654ca00086b19175a0cddd70127fe25bca7be7f8f7410d3274bf2877523efe1a8568fe2f9e3d92a01a805dfdcf730945ed02d621"
}
