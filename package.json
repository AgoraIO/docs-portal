{
  "name": "docs-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:raw": "bun run openapi:sync && vite build",
    "build": "node scripts/build-static-docs.mjs",
    "start": "vite preview",
    "preview": "vite preview",
    "test": "vitest run",
    "docs:assets": "node scripts/audit-static-assets.mjs",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "openapi:sync": "node scripts/sync-openapi-assets.mjs",
    "docs:links": "node scripts/audit-doc-links.mjs",
    "lint": "biome check biome.json package.json source.config.ts tsconfig.json vite.config.ts src",
    "format": "biome format --write"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@orama/orama": "^3.1.18",
    "@tanstack/react-router": "1.168.22",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-start": "1.167.41",
    "@tanstack/start-static-server-functions": "1.166.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.9.0",
    "fumadocs-mdx": "15.0.7",
    "fumadocs-openapi": "^10.10.0",
    "fumadocs-ui": "16.9.0",
    "i18next": "^26.0.7",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "remark-directive": "^4.0.0",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "4.0.9",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.9.0",
    "nitro": "^3.0.260311-beta",
    "sharp": "^0.35.1",
    "srvx": "^0.11.15",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@8.6.4+sha512.4968d718da1be7dbba5efaab654ca00086b19175a0cddd70127fe25bca7be7f8f7410d3274bf2877523efe1a8568fe2f9e3d92a01a805dfdcf730945ed02d621"
