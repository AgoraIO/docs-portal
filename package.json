{
  "name": "docs-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:full": "vite dev",
    "dev:scope": "bun run dev",
    "build": "bun run legacy-redirects:check && bun run build:static",
    "build:static": "bun run convoai:mapping:check && bun run openapi:sync && bun run docs:last-updated && bun run docs:static-payload && bun run build:app:static && bun run build:route-html",
    "build:app:static": "TSS_STATIC_PRERENDER=true VITE_TSS_SPA_STATIC_EXPERIMENT=true vite build",
    "build:route-html": "node --experimental-strip-types scripts/generate-static-route-html.mjs",
    "docs:static-payload": "TSS_STATIC_PRERENDER=true VITE_TSS_SPA_STATIC_EXPERIMENT=true node scripts/generate-static-docs-payload.mjs",
    "docs:last-updated": "node scripts/generate-docs-last-updated-manifest.mjs",
    "start": "bun run preview",
    "preview": "TSS_SPA_STATIC_EXPERIMENT=true VITE_TSS_SPA_STATIC_EXPERIMENT=true vite preview",
    "test": "vitest run",
    "types:check": "bun run convoai:mapping:check && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "convoai:mapping": "node scripts/generate-convoai-doc-pages.mjs",
    "convoai:mapping:check": "node scripts/generate-convoai-doc-pages.mjs --check",
    "openapi:sync": "node scripts/sync-openapi-assets.mjs",
    "assets:upload": "node scripts/upload-doc-assets.mjs",
    "search:sync": "bun scripts/sync-algolia-search.mjs",
    "search:replay": "bun scripts/replay-algolia-search.ts",
    "docs:links": "node scripts/audit-doc-links.mjs",
    "docs:links:strict": "node scripts/audit-doc-links.mjs --fail-on-invalid",
    "docs:links:classify": "node scripts/classify-doc-link-audit.mjs --out=docs/agents/reports/2026-06-30-doc-link-strict-classification.md",
    "docs:links:classify:check": "node scripts/classify-doc-link-audit.mjs --check --out=docs/agents/reports/2026-06-30-doc-link-strict-classification.md",
    "docs:links:external": "node scripts/audit-doc-links.mjs --check-external --external-concurrency=8 --external-retries=2 --external-timeout=5000",
    "api-ref:docs-links": "node scripts/audit-api-ref-docs-links.mjs",
    "legacy-redirects:generate": "node scripts/generate-legacy-redirect-artifacts.mjs",
    "legacy-redirects:check": "node scripts/generate-legacy-redirect-artifacts.mjs --check",
    "agent-discovery:check": "node --experimental-strip-types scripts/validate-agent-discovery.ts",
    "docs:lint:english": "node scripts/audit-english-doc-low-errors.mjs",
    "docs:migration-parity": "node scripts/audit-migration-parity.mjs",
    "docs:rendering-audit": "node scripts/audit-doc-rendering-patterns.mjs --out=docs/agents/reports/2026-06-25-legacy-rendering-pattern-audit",
    "og:generate": "node scripts/generate-og-images.mjs",
    "lint": "biome check biome.json package.json source.config.ts tsconfig.json vite.config.ts src",
    "format": "biome format --write",
    "qa:api": "node scripts/check-api-reference-quality.mjs",
    "qa:api:shared": "node scripts/check-api-reference-shared.mjs",
    "test:api-quality": "vitest run --maxWorkers=2 scripts/api-reference-quality.test.ts scripts/api-reference-presentation.test.ts scripts/api-reference-structure*.test.ts scripts/api-reference-shared.test.ts scripts/api-code-language*.test.ts src/components/api-reference-rendering.test.tsx src/components/DocsCodeBlock.test.tsx src/lib/openapi/response-view.test.ts src/lib/openapi/normalize-schema.test.ts src/components/mdx.test.tsx src/components/mdx/HighlightedCode.test.tsx src/components/openapi/*.test.tsx src/lib/code/options.test.tsx src/lib/api-reference-*.test.ts src/styles/app-css-regressions.test.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@fumadocs/api-docs": "0.2.9",
    "@orama/orama": "^3.1.18",
    "@shikijs/langs": "4.5.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/start-static-server-functions": "1.167.44",
    "algoliasearch": "^5.61.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-openapi": "12.5.6",
    "fumadocs-ui": "16.17.9",
    "github-slugger": "^2.0.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.64.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "2.2.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.441.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "remark-directive": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "1.2.0",
    "happy-dom": "^21.0.4",
    "js-yaml": "5.5.0",
    "nitro": "^3.0.260903-beta",
    "srvx": "^1.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@fumadocs/api-docs@0.2.9": "patches/@fumadocs%2Fapi-docs@0.2.9.patch",
    "@tanstack/react-router@1.170.46": "patches/@tanstack%2Freact-router@1.170.46.patch"
  }
}
