    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260311-beta",
    "happy-dom": "^20.9.0",
    "serve": "^14.2.6",
    "srvx": "^0.11.15",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "@biomejs/biome": "^2.4.13",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
