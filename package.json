{
  "name": "docs-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "serve .output/public",
    "preview": "vite preview",
    "test": "vitest run",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check biome.json package.json source.config.ts tsconfig.json vite.config.ts src",
    "format": "biome format --write"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@tanstack/react-router": "1.168.22",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-start": "1.167.41",
    "@tanstack/start-static-server-functions": "1.166.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.7.16",
    "fumadocs-mdx": "14.2.14",
    "i18next": "^26.0.7",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "tailwind-merge": "^3.5.0",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
