{
  "name": "docs-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docs:last-updated && vite dev",
    "dev:full": "bun run dev",
    "dev:scope": "bun run dev",
    "build": "bun run legacy-redirects:check && bun run build:static",
    "build:static": "bun run openapi:sync && bun run docs:last-updated && bun run docs:static-payload && bun run build:app:static && bun run build:route-html",
    "build:app:static": "NODE_OPTIONS=--max-old-space-size=8192 TSS_SPA_STATIC_EXPERIMENT=true VITE_TSS_SPA_STATIC_EXPERIMENT=true vite build",
    "build:route-html": "node --experimental-strip-types scripts/generate-static-route-html.mjs",
    "docs:static-payload": "NODE_OPTIONS=--max-old-space-size=8192 TSS_SPA_STATIC_EXPERIMENT=true VITE_TSS_SPA_STATIC_EXPERIMENT=true node scripts/generate-static-docs-payload.mjs",
    "docs:last-updated": "node scripts/generate-docs-last-updated-manifest.mjs",
    "start": "bun run preview",
    "preview": "TSS_SPA_STATIC_EXPERIMENT=true VITE_TSS_SPA_STATIC_EXPERIMENT=true vite preview",
    "test": "vitest run",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "openapi:sync": "node scripts/sync-openapi-assets.mjs",
    "assets:upload": "node scripts/upload-doc-assets.mjs",
    "search:sync": "bun scripts/sync-algolia-search.mjs",
    "docs:links": "node scripts/audit-doc-links.mjs",
    "docs:links:cn": "bun scripts/audit-cn-doc-links.mjs --mode static",
    "docs:links:cn:built": "bun scripts/audit-cn-doc-links.mjs --mode built",
    "docs:links:cn:full": "bun scripts/audit-cn-doc-links.mjs --mode full",
    "docs:links:strict": "node scripts/audit-doc-links.mjs --fail-on-invalid",
    "docs:links:openapi-zh": "node scripts/audit-doc-links.mjs --openapi-zh-only",
    "docs:links:openapi-zh:strict": "node scripts/audit-doc-links.mjs --openapi-zh-only --fail-on-invalid",
    "docs:links:openapi-zh:baseline": "node scripts/check-openapi-zh-link-baseline.mjs",
    "docs:links:openapi-zh:baseline:update": "node scripts/check-openapi-zh-link-baseline.mjs --update",
    "docs:links:cn-api:normalize": "node scripts/normalize-cn-api-links.mjs",
    "docs:links:cn-api:check": "node scripts/normalize-cn-api-links.mjs --check",
    "docs:links:classify": "node scripts/classify-doc-link-audit.mjs --out=docs/agents/reports/2026-06-30-doc-link-strict-classification.md",
    "docs:links:classify:check": "node scripts/classify-doc-link-audit.mjs --check --out=docs/agents/reports/2026-06-30-doc-link-strict-classification.md",
    "docs:links:external": "node scripts/audit-doc-links.mjs --check-external --external-concurrency=8 --external-retries=2 --external-timeout=5000",
    "legacy-redirects:generate": "node scripts/generate-legacy-redirect-artifacts.mjs",
    "legacy-redirects:check": "node scripts/generate-legacy-redirect-artifacts.mjs --check",
    "shengwang-redirects:candidates": "bun scripts/generate-shengwang-redirect-candidates.mjs",
    "shengwang-redirects:finalize": "node scripts/finalize-shengwang-redirect-artifacts.mjs",
    "shengwang-redirects:check": "node scripts/finalize-shengwang-redirect-artifacts.mjs --check",
    "docs:lint:english": "node scripts/audit-english-doc-low-errors.mjs",
    "docs:mdx-build-syntax": "bun scripts/audit-mdx-build-syntax.mjs",
    "docs:tables": "bun scripts/audit-doc-tables.mjs",
    "docs:migration-parity": "node scripts/audit-migration-parity.mjs",
    "docs:single-fidelity": "node scripts/audit-single-doc-fidelity.mjs",
    "docs:rendering-audit": "node scripts/audit-doc-rendering-patterns.mjs --out=docs/agents/reports/2026-06-25-legacy-rendering-pattern-audit",
    "api-center:report": "node scripts/generate-api-center-report.mjs",
    "api-center:report:check": "node scripts/generate-api-center-report.mjs --check",
    "api-center:migrate": "bun scripts/migrate-api-center.mjs",
    "api-center:migrate:mdx": "bun scripts/migrate-api-center-mdx.mjs",
    "api-center:html-structure:normalize-existing": "bun scripts/normalize-api-center-existing-html-structure.mjs",
    "api-center:html-structure:normalize-existing:check": "bun scripts/normalize-api-center-existing-html-structure.mjs --check",
    "api-center:links:normalize-existing": "bun scripts/normalize-api-center-existing-links.mjs",
    "api-center:links:normalize-existing:check": "bun scripts/normalize-api-center-existing-links.mjs --check",
    "api-center:navigation": "bun scripts/generate-api-center-navigation.mjs",
    "api-center:navigation:check": "bun scripts/generate-api-center-navigation.mjs --check",
    "api-center:openapi:normalize": "bun scripts/normalize-api-center-openapi.mjs",
    "api-center:openapi:normalize:check": "bun scripts/normalize-api-center-openapi.mjs --check",
    "api-center:openapi:audit": "bun scripts/audit-api-center-openapi.mjs",
    "api-center:openapi:audit:check": "bun scripts/audit-api-center-openapi.mjs --check",
    "api-center:audit": "bun scripts/audit-api-center-migration.mjs",
    "api-center:audit:check": "bun scripts/audit-api-center-migration.mjs --check",
    "api-center:provenance": "bun scripts/audit-api-center-provenance.mjs",
    "api-center:provenance:check": "bun scripts/audit-api-center-provenance.mjs --check",
    "api-center:links": "bun scripts/audit-api-center-links.mjs",
    "api-center:links:check": "bun scripts/audit-api-center-links.mjs --check",
    "lint": "biome check biome.json package.json source.config.ts tsconfig.json vite.config.ts src",
    "format": "biome format --write",
    "build:service": "bun run docs:last-updated && node scripts/clean-service-output.mjs && NODE_OPTIONS=--max-old-space-size=8192 DOCS_BUILD_TARGET=service vite build",
    "start:service": "node .output/server/index.mjs",
    "search:export:cn": "bun scripts/search/export-cn.ts",
    "search:release:cn": "bun scripts/search/release-cn.ts",
    "search:quality:cn": "node scripts/search/compare-cn-top-queries.mjs",
    "search:verify:urls:cn": "node scripts/search/verify-cn-public-urls.mjs",
    "search:prepare:cn": "bun scripts/search/sync-cn.ts prepare",
    "search:promote:cn": "bun scripts/search/sync-cn.ts promote",
    "qa:api": "node scripts/check-api-reference-quality.mjs",
    "qa:api:shared": "node scripts/check-api-reference-shared.mjs",
    "test:api-quality": "vitest run --maxWorkers=2 scripts/api-reference-quality.test.ts scripts/api-reference-presentation.test.ts scripts/api-reference-structure*.test.ts scripts/api-reference-shared.test.ts scripts/api-code-language*.test.ts src/components/api-reference-rendering.test.tsx src/components/mdx.test.tsx src/components/mdx/HighlightedCode.test.tsx src/components/openapi/*.test.tsx src/lib/code/options.test.tsx src/lib/api-reference-*.test.ts src/styles/app-css-regressions.test.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@fumadocs/api-docs": "0.2.9",
    "@orama/orama": "^3.1.18",
    "@shikijs/langs": "^4.5.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/start-static-server-functions": "1.167.44",
    "algoliasearch": "^5.61.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-openapi": "12.5.6",
    "fumadocs-ui": "16.17.9",
    "i18next": "^26.5.11",
    "iron-session": "^9.0.1",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.441.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "github-slugger": "^2.0.0",
    "happy-dom": "^21.0.4",
    "nitro": "^3.0.260903-beta",
    "remark-parse": "^11.0.0",
    "srvx": "^1.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@fumadocs/api-docs@0.2.9": "patches/@fumadocs%2Fapi-docs@0.2.9.patch",
    "@tanstack/react-router@1.170.46": "patches/@tanstack%2Freact-router@1.170.46.patch"
  }
}
