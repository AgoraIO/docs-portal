{
  "buildCommand": "bun run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "bulkRedirectsPath": "vercel-legacy-redirects.json",
  "redirects": [
    {
      "source": "/doc/:path*",
      "destination": "https://doc.shengwang.cn/doc/:path*",
      "statusCode": 308
