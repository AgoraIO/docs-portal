{
  "buildCommand": "bun run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "bulkRedirectsPath": "vercel-legacy-redirects.json",
  "redirects": [
    {
      "source": "/doc/:path*",
      "destination": "https://doc.shengwang.cn/doc/:path*",
      "statusCode": 308
    },
    {
      "source": "/api-ref/:path*",
      "destination": "https://doc.shengwang.cn/api-ref/:path*",
      "statusCode": 308
    },
    {
      "source": "/cn",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/skill.md",
      "destination": "https://raw.githubusercontent.com/AgoraIO/skills/main/skills/agora/SKILL.md",
      "statusCode": 307
