diff --git a/helm/docs-portal/scripts/archive-cn-search-static.sh b/helm/docs-portal/scripts/archive-cn-search-static.sh
new file mode 100644
index 0000000..d572e7a
--- /dev/null
+++ b/helm/docs-portal/scripts/archive-cn-search-static.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+set -eu
+
+# Keep build paths intact. Public URLs are normalized by the source exporter.
+cd "${1:-/usr/share/nginx/html}"
+test -d __static
+test -f sitemap.xml
+set -- __static sitemap.xml
+for entry in zh-CN introduction realtime-media solutions api-reference reference ai; do
+  if [ -d "$entry" ]; then
+    set -- "$@" "$entry"
+  fi
+done
+if [ "$#" -le 2 ]; then
+  printf '%s\n' 'No CN documentation directories in the frontend image' >&2
+  exit 1
+fi
+exec tar -cf - "$@"
diff --git a/helm/docs-portal/scripts/archive-cn-search-static.test.mjs b/helm/docs-portal/scripts/archive-cn-search-static.test.mjs
new file mode 100644
index 0000000..6cfb5e5
--- /dev/null
+++ b/helm/docs-portal/scripts/archive-cn-search-static.test.mjs
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtemp, mkdir, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+for (const prefix of ['zh-CN/', '']) {
+  test(`archives actual CN build paths: ${prefix || 'public roots'}`, async t => {
+    const root = await mkdtemp(path.join(os.tmpdir(), 'cn-static-archive-'));
+    t.after(() => rm(root, { recursive: true, force: true }));
+    for (const file of ['__static/docs-routes.json', 'sitemap.xml', `${prefix}realtime-media/rtc/index.html`, `${prefix}reference/faq/index.html`, 'en/introduction/index.html', 'assets/large-file.js']) {
+      await mkdir(path.dirname(path.join(root, file)), { recursive: true });
+      await writeFile(path.join(root, file), 'fixture');
+    }
+    const result = spawnSync('sh', [fileURLToPath(new URL('./archive-cn-search-static.sh', import.meta.url)), root]);
+    assert.equal(result.status, 0, result.stderr.toString());
+    const listing = spawnSync('tar', ['-tf', '-'], { input: result.stdout, encoding: 'utf8' });
+    assert.equal(listing.status, 0, listing.stderr);
+    assert.ok(listing.stdout.includes(`${prefix}realtime-media/rtc/index.html`));
+    assert.ok(listing.stdout.includes(`${prefix}reference/faq/index.html`));
+    assert.ok(listing.stdout.includes('__static/docs-routes.json'));
+    assert.ok(listing.stdout.includes('sitemap.xml'));
+    assert.ok(!listing.stdout.includes('en/introduction') && !listing.stdout.includes('assets/large-file'));
+  });
+}
