# Docs publication boundary: global publishes non-zh-CN locales; cn publishes
# only zh-CN. Missing values default to global.
VITE_DOCS_REGION=global

# Public canonical origin. Required for cn builds; global defaults to
# https://docs.agora.io when omitted.
SITE_URL=

# Global search configuration. CN uses the same-origin /api/search service.
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_API_KEY=
VITE_ALGOLIA_INDEX_NAME=
VITE_SEARCH_RANKING_V2=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX_NAME=
# Browser-safe Project API Key / project token, never a Personal API Key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_GTM_ID=
# CN phase-0 events and task feedback, embedded at build time.
VITE_DOCS_MEASUREMENT_ENABLED=false
VITE_DOCS_ENVIRONMENT=local
VITE_DOCS_APP_RELEASE=unknown
# Optional runtime SHA of the index currently serving MEILI_INDEX_UID.
# Update on index promotion/rollback, independently of the application release.
# Leave empty when unverified; diagnostics then report a null index revision.
DOCS_SEARCH_INDEX_REVISION=

# Docs static asset uploads. Copy these values to .env.local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DOC_ASSETS_S3_REGION=
DOC_ASSETS_S3_BUCKET=
DOC_ASSETS_CDN_BASE_URL=https://assets-docs.agora.io/
DOC_ASSETS_CACHE_CONTROL=public, max-age=31536000, immutable
